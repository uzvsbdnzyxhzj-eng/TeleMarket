{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing balances and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "numericId": { "type": "number", "description": "Auto-incrementing sequential user ID" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "telegramId": { "type": "string" },
        "balanceUSD": { "type": "number" },
        "total_deposited": { "type": "number" },
        "total_spent": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"] },
        "referredBy": { "type": "string" },
        "referralEarnings": { "type": "number" },
        "lastActiveAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "balanceUSD", "role"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Records user topups, withdrawals, and purchases",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["topup", "withdraw", "purchase", "deposit", "referral_bonus", "fee", "buy", "ad_reward", "smm_order", "p2p_buy", "child_panel_order", "purchase_course", "purchase_tool", "purchase_gemini"] },
        "txType": { "type": "string", "enum": ["Credit", "Debit"] },
        "amountUSD": { "type": "number" },
        "status": { "type": "string", "enum": ["WAIT", "OK", "FAILED", "pending", "paid", "success", "Pending", "In progress", "Completed", "Partial", "Processing", "Canceled", "completed"] },
        "details": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "type", "amountUSD", "status", "createdAt"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "User generated banner advertisements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "linkUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "rejected", "pending_review"] },
        "planMonths": { "type": "number" },
        "price": { "type": "number" },
        "isActive": { "type": "boolean" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "imageUrl", "isActive", "expiresAt", "createdAt"]
    },
    "Counter": {
      "title": "Counter",
      "description": "Tracks auto-incrementing sequences",
      "type": "object",
      "properties": {
        "lastId": { "type": "number" },
        "totalUsers": { "type": "number" },
        "totalTransactions": { "type": "number" }
      },
      "required": ["lastId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support tickets",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "subject", "description", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "App settings like banners",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" },
        "linkUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "banners": { "type": "array" }
      }
    },
    "Course": {
      "title": "Course",
      "description": "Premium courses and digital products offered in the store",
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "title": { "type": "string" },
        "oldPrice": { "type": "number" },
        "price": { "type": "number" },
        "rating": { "type": "number" },
        "badge": { "type": "string" },
        "features": { "type": "array" },
        "imageUrl": { "type": "string" }
      },
      "required": ["category", "title", "price"]
    },
    "GeminiSubscription": {
      "title": "GeminiSubscription",
      "description": "Premium Google Gemini Pro subscriptions with user and admin fields",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "geminiEmail": { "type": "string" },
        "geminiPassword": { "type": "string" },
        "geminiBackupCodes": { "type": "string" },
        "plan": { "type": "string", "enum": ["member_1m", "member_3m", "member_6m", "member_12m", "personal_12m", "1month", "3month", "6month", "12month"] },
        "priceUSD": { "type": "number" },
        "country": { "type": "string" },
        "createdAt": { "type": "number" },
        "durationDays": { "type": "number" },
        "activatedAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired", "pending", "canceled", "cancelled"] },
        "familyManagerEmail": { "type": "string" }
      },
      "required": ["userId", "geminiEmail", "geminiPassword", "geminiBackupCodes", "plan", "priceUSD", "country", "createdAt", "expiresAt", "status", "familyManagerEmail"]
    },
    "VirtualOrder": {
      "title": "VirtualOrder",
      "description": "Virtual phone number purchase order from Telekos",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "activationId": { "type": "string" },
        "phone": { "type": "string" },
        "serviceCode": { "type": "string" },
        "serviceName": { "type": "string" },
        "countryId": { "type": "string" },
        "countryName": { "type": "string" },
        "priceIDR": { "type": "number" },
        "priceUSD": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "last_checked": { "type": "number" },
        "otp": { "type": "string" }
      },
      "required": ["userId", "activationId", "phone", "serviceCode", "status", "createdAt"]
    }
  },
  "firestore": {
    "virtual_orders/{orderId}": {
      "schema": { "$ref": "#/entities/VirtualOrder" },
      "description": "Telekos virtual numbers purchase orders"
    },
    "gemini_subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/GeminiSubscription" },
      "description": "Google Gemini Pro subscriptions mapping with Family Manager email"
    },
    "courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Available products and courses"
    },
    "counters/{counterId}": {
      "schema": { "$ref": "#/entities/Counter" },
      "description": "Stores sequence counters"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles with balances"
    },
    "transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Global transactions log"
    },
    "ads/{adId}": {
      "schema": { "$ref": "#/entities/Advertisement" },
      "description": "User advertisements"
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System and user notifications"
    },
    "support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "User support tickets"
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "App settings"
    }
  }
}
