{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing balances and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "numericId": { "type": "number", "description": "Auto-incrementing sequential user ID" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "telegramId": { "type": "string" },
        "balanceUSD": { "type": "number" },
        "total_deposited": { "type": "number" },
        "total_spent": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"] },
        "referredBy": { "type": "string" },
        "referralEarnings": { "type": "number" },
        "lastActiveAt": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "balanceUSD", "role"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Records user topups, withdrawals, and purchases",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["topup", "withdraw", "purchase", "transfer", "refund"] },
        "txType": { "type": "string", "enum": ["Credit", "Debit"] },
        "amountUSD": { "type": "number" },
        "status": { "type": "string", "enum": ["WAIT", "OK", "FAILED", "pending", "paid"] },
        "details": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "type", "amountUSD", "status", "createdAt"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "User generated banner advertisements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "linkUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "rejected", "pending_review"] },
        "planMonths": { "type": "number" },
        "price": { "type": "number" },
        "isActive": { "type": "boolean" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "imageUrl", "isActive", "expiresAt", "createdAt"]
    },
    "Counter": {
      "title": "Counter",
      "description": "Tracks auto-incrementing sequences",
      "type": "object",
      "properties": {
        "lastId": { "type": "number" },
        "totalUsers": { "type": "number" },
        "totalTransactions": { "type": "number" }
      },
      "required": ["lastId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support tickets",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "subject", "description", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "App settings like banners",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" },
        "linkUrl": { "type": "string" },
        "isActive": { "type": "boolean" },
        "banners": { "type": "array" }
      }
    }
  },
  "firestore": {
    "counters/{counterId}": {
      "schema": { "$ref": "#/entities/Counter" },
      "description": "Stores sequence counters"
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles with balances"
    },
    "transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Global transactions log"
    },
    "ads/{adId}": {
      "schema": { "$ref": "#/entities/Advertisement" },
      "description": "User advertisements"
    },
    "notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System and user notifications"
    },
    "support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "User support tickets"
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "App settings"
    }
  }
}
